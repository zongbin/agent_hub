# ============================================================
# 智知 AgentHub 后端 — 环境变量配置（复制为 .env 或导出到系统环境）
# ============================================================

# ---- 阿里云 Redis（ApsaraDB for Redis）----
# 外网地址：登录阿里云控制台 → ApsaraDB Redis → 实例列表 → 目标实例
#           → 「实例信息」→「连接地址」复制「外网地址」
#           格式类似：r-xxxxx.redis.rds.aliyuncs.com
REDIS_HOST=r-xxxxx.redis.rds.aliyuncs.com
REDIS_PORT=6379
# 实例创建时设置的密码（无密码则留空）
REDIS_PASS=YourRedisPassword123
REDIS_DB=0

# ---- PostgreSQL ----
DB_HOST=localhost
DB_USER=agenthub
DB_PASS=agenthub

# ---- JWT ----
JWT_SECRET=your-long-random-secret-here

# ---- DeepSeek LLM ----
LLM_API_KEY=sk-xxxxxxxx

# ---- SuperAgent Python 服务 ----
AGENT_SERVICE_URL=http://localhost:8000

# ---- 文件存储路径 ----
STORAGE_ROOT_PATH=./data/docs
